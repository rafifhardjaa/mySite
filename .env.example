# Public build-time variables (safe to expose — they end up in the client bundle).
# Copy to .env.local and fill in. Without these the contact form renders in a
# disabled state and says so, instead of failing silently on submit.

# Cloudflare Worker URL that receives the contact POST.
PUBLIC_CONTACT_ENDPOINT=https://api.yourdomain.com

# Turnstile site key (not the secret). Create at dash.cloudflare.com → Turnstile.
PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000