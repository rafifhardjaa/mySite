---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Navbar from '@/components/layout/Navbar.astro'
import Footer from '@/components/layout/Footer.astro'
import { getLang } from '@/i18n/utils'

interface Props {
  title: string
  description?: string
  localeSwitchHref?: string | null
  hasAlternate?: boolean
  noindex?: boolean
}

const { title, description, localeSwitchHref, hasAlternate, noindex = false } = Astro.props
const lang = getLang(Astro.currentLocale)
---

<BaseLayout title={title} description={description} hasAlternate={hasAlternate} noindex={noindex}>
  <Navbar lang={lang} localeSwitchHref={localeSwitchHref} />
  <main class="flex-1 pt-14 pb-24 md:pb-0">
    <slot />
  </main>
  <Footer lang={lang} />
</BaseLayout>
