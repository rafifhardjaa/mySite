---
import DocsLayout from '@/layouts/DocsLayout.astro'
import { getLang, useTranslation, localePath, formatShortDate } from '@/i18n/utils'
import { hasNoteTranslation } from '@/lib/notes'

interface Props {
  title: string
  description?: string
  publishedAt: Date
  updatedAt?: Date
  notePath: string
  headings?: { depth: number; slug: string; text: string }[]
}

const { title, description, publishedAt, updatedAt, notePath, headings = [] } = Astro.props

const lang = getLang(Astro.currentLocale)
const t = useTranslation(lang)
const backHref = localePath(lang, '/notes')

// A translation may not exist yet. Pointing the language switch at the other
// locale anyway produced a 404, so the switch is hidden when nothing is there.
const otherLang = lang === 'id' ? 'en' : 'id'
const otherExists = await hasNoteTranslation(notePath, otherLang)
const localeSwitchHref = otherExists ? localePath(otherLang, `/notes/${notePath}`) : null
---

<DocsLayout
  title={title}
  description={description}
  localeSwitchHref={localeSwitchHref}
  hasAlternate={otherExists}
  headings={headings}
  tocLabel={t('toc.label')}
>
  <header class="mb-12">
    <a
      href={backHref}
      class="mb-6 inline-block text-sm text-text-muted transition-colors hover:text-accent"
    >
      ← {t('note.backToNotes')}
    </a>
    <h1 class="mb-4 text-3xl font-semibold">{title}</h1>
    <div class="flex items-center gap-4 text-sm text-text-muted">
      <time>{formatShortDate(publishedAt, lang)}</time>
      {
        updatedAt && (
          <>
            <span>•</span>
            <time>Updated: {formatShortDate(updatedAt, lang)}</time>
          </>
        )
      }
    </div>
  </header>
  <div class="prose prose-neutral max-w-[72ch] dark:prose-invert">
    <slot />
  </div>
</DocsLayout>
