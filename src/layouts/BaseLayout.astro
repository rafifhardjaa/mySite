---
import { SITE } from '@/lib/constants'
import type { ArticleSchema } from '@/lib/schema'
import { getLang, localePath, stripLocalePrefix, useTranslation } from '@/i18n/utils'
import StructuredData from '@/components/seo/StructuredData.astro'
import '@/styles/global.css'

interface Props {
  title: string
  description?: string
  // Set when the page has no counterpart in the other locale (an untranslated
  // note), so no hreflang pair is advertised.
  hasAlternate?: boolean
  // Error pages: a direct hit answers 200, so opt out of indexing.
  noindex?: boolean
  // Note pages: adds BlogPosting and BreadcrumbList to the JSON-LD graph.
  article?: ArticleSchema
}

const { title, description, hasAlternate = true, noindex = false, article } = Astro.props

// The locale is part of the URL, so the correct language is known before any
// client script runs. Nothing about language needs to be stored or swapped.
const lang = getLang(Astro.currentLocale)
const origin = Astro.site ?? 'https://rafifhardja.xyz'
const localeFree = stripLocalePrefix(Astro.url.pathname)
const canonical = new URL(localePath(lang, localeFree), origin).href
const t = useTranslation(lang)
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#faf9f5" />
    <link rel="canonical" href={canonical} />
    <StructuredData canonical={canonical} lang={lang} article={article} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', origin).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'id' ? 'en_US' : 'id_ID'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={new URL('/og-image.png', origin).href} />
    {
      hasAlternate && (
        <>
          <link
            rel="alternate"
            hreflang="en"
            href={new URL(localePath('en', localeFree), origin).href}
          />
          <link
            rel="alternate"
            hreflang="id"
            href={new URL(localePath('id', localeFree), origin).href}
          />
          <link rel="alternate" hreflang="x-default" href={new URL(localeFree, origin).href} />
        </>
      )
    }
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} · Notes`}
      href={localePath(lang, '/notes/rss.xml')}
    />
    <script is:inline>
      const theme =
        localStorage.getItem('theme') ??
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      document.documentElement.classList.toggle('dark', theme === 'dark')
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', theme === 'dark' ? '#141413' : '#faf9f5')

      const layout = localStorage.getItem('layout') ?? 'default'
      document.documentElement.setAttribute('data-layout', layout)

      const animation = localStorage.getItem('animation') ?? 'system'
      if (animation !== 'system') {
        document.documentElement.setAttribute('data-animation', animation)
      }
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:border focus:border-border focus:bg-bg focus:px-4 focus:py-2 focus:text-sm focus:text-text focus:shadow-lg"
      >{t('a11y.skip')}</a
    >
    <slot />
  </body>
</html>
