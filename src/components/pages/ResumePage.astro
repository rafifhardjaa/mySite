---
import PageLayout from '@/layouts/PageLayout.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import ExternalLink from '@/components/ui/ExternalLink.astro'
import { SITE, PAGE_CONTAINER_CLASS } from '@/lib/constants'
import { useLocale } from '@/i18n/utils'

const { lang, t } = useLocale(Astro.currentLocale)
---

<PageLayout title={t('resume.heading')} description={SITE.description[lang]}>
  <div class={PAGE_CONTAINER_CLASS}>
    <SectionLabel label={t('resume.heading')} class="mb-12" />
    <div class="prose prose-neutral max-w-[70ch] dark:prose-invert">
      <p class="text-lg">
        {t('resume.download')}{' '}
        <ExternalLink href="/resume.pdf" class="text-accent hover:text-accent-hover">
          PDF
        </ExternalLink>
      </p>
      <h2>{t('resume.experience')}</h2>
      <p>{t('resume.experiencePlaceholder')}</p>
      <h2>{t('resume.skills')}</h2>
      <p>{t('resume.skillsPlaceholder')}</p>
      <h2>{t('resume.education')}</h2>
      <p>{t('resume.educationPlaceholder')}</p>
    </div>
  </div>
</PageLayout>
