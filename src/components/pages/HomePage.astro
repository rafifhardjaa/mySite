---
import { getCollection } from 'astro:content'
import PageLayout from '@/layouts/PageLayout.astro'
import Icon from '@/components/ui/Icon.astro'
import Pfp from '@/components/sections/Pfp.astro'
import pfp1 from '@/assets/pfp-1.jpg'
import pfp2 from '@/assets/pfp-2.jpeg'
import Gallery from '@/components/sections/Gallery.astro'
import ProjectCard from '@/components/ui/ProjectCard.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import { SITE } from '@/lib/constants'
import { useTranslation, getLang, localePath, noteHref, formatShortDate } from '@/i18n/utils'
import { getPublishedNotes } from '@/lib/notes'

const lang = getLang(Astro.currentLocale)
const t = useTranslation(lang)

const socials = [
  { href: SITE.github, icon: 'github' as const, label: 'GitHub' },
  { href: SITE.linkedin, icon: 'linkedin' as const, label: 'LinkedIn' },
  { href: `mailto:${SITE.email}`, icon: 'mail' as const, label: 'Email' },
]

const formalName = SITE.name.slice(0, SITE.name.length - SITE.nickname.length).trim()

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))

const allNotes = await getPublishedNotes(lang)
const notes = allNotes.slice(0, 5)
const totalNotes = allNotes.length
---

<PageLayout title={SITE.identity[lang]} description={SITE.description[lang]}>
  <div class="mx-auto layout-container px-6 pt-8 pb-16">
    <section class="mb-20 flex flex-col gap-6 sm:flex-row sm:items-start">
      <Pfp src={pfp1} hoverSrc={pfp2} alt={SITE.name} />

      <div>
        <h1 class="mb-4 text-3xl font-semibold sm:text-4xl">
          {formalName}<span class="text-accent">{' '}{SITE.nickname}</span>
        </h1>
        <p class="text-lg text-text-muted leading-relaxed">{SITE.bio[lang]}</p>
        <p class="mt-3 flex items-start gap-2 font-mono-jb text-xs italic text-text-subtle">
          <span
            class="mt-[0.5em] inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
            aria-hidden="true"></span>
          {SITE.availability[lang]}
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-2">
          {
            socials.map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                {...(social.icon === 'mail'
                  ? {}
                  : { target: '_blank', rel: 'noopener noreferrer' })}
                class="group inline-flex items-center gap-2 rounded-full border border-border bg-bg-subtle px-3 py-1.5 text-sm text-text transition-colors hover:border-accent hover:bg-bg hover:text-accent"
              >
                <Icon
                  name={social.icon}
                  class="h-4 w-4 text-text-muted transition-colors group-hover:text-accent"
                />
                <span>{social.label}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {
      projects.length > 0 && (
        <section class="mb-20">
          <SectionLabel label={t('home.projects.heading')} class="mb-8" />
          <div class="space-y-6">
            {projects.map((project) => (
              <ProjectCard project={project} lang={lang} />
            ))}
          </div>
        </section>
      )
    }

    {
      notes.length > 0 && (
        <section>
          <SectionLabel label={t('home.notes.heading')} class="mb-3" />
          <p class="mb-8 max-w-[70ch] text-text-muted">{t('home.notes.body')}</p>
          <ul class="border-t border-border">
            {notes.map((note) => (
              <li class="border-b border-border">
                <a
                  href={noteHref(note, lang)}
                  class="group flex items-baseline gap-3 py-4 sm:gap-4"
                >
                  <time class="w-28 shrink-0 font-mono text-sm whitespace-nowrap text-text-muted">
                    {formatShortDate(note.data.publishedAt, lang)}
                  </time>
                  <span aria-hidden="true" class="text-text-subtle">
                    —
                  </span>
                  <span class="font-serif text-xl leading-snug transition-colors group-hover:text-accent">
                    {note.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a
            href={localePath(lang, '/notes')}
            class="mt-8 inline-block text-sm text-accent transition-colors hover:text-accent-hover"
          >
            {t('home.notes.more', { count: totalNotes })} →
          </a>
        </section>
      )
    }

    <div class="mt-20">
      <Gallery lang={lang} />
    </div>
  </div>
</PageLayout>
