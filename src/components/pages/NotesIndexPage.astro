---
import PageLayout from '@/layouts/PageLayout.astro'
import NoteRow from '@/components/ui/NoteRow.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import { SITE, PAGE_CONTAINER_CLASS } from '@/lib/constants'
import { useLocale } from '@/i18n/utils'
import { getPublishedNotes } from '@/lib/notes'

const { lang, t } = useLocale(Astro.currentLocale)

const notes = await getPublishedNotes(lang)
---

<PageLayout title={t('notes.heading')} description={SITE.description[lang]}>
  <div class={PAGE_CONTAINER_CLASS}>
    <SectionLabel label={t('notes.heading')} class="mb-12" />
    {
      notes.length === 0 ? (
        <p class="text-text-muted">{t('notes.empty')}</p>
      ) : (
        <div class="border-t border-border">
          {notes.map((note) => (
            <NoteRow note={note} lang={lang} />
          ))}
        </div>
      )
    }
  </div>
</PageLayout>
