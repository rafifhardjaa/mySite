---
import PageLayout from '@/layouts/PageLayout.astro'
import Icon from '@/components/ui/Icon.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import { SITE, INLINE_LINK_CLASS } from '@/lib/constants'
import { useTranslation, getLang, formatShortDate } from '@/i18n/utils'

const lang = getLang(Astro.currentLocale)
const t = useTranslation(lang)

const lastUpdated = formatShortDate(new Date(2026, 9, 12), lang)

const openTo = [
  'now.itemWork',
  'now.itemContribution',
  'now.itemInternship',
  'now.itemCollaboration',
]

const projects = [
  { name: 'TeaMusic', href: 'https://teamusic.my.id/' },
  { name: 'SDK Ads', href: 'https://github.com/rafifhardjaa/SdkAds' },
  { name: 'Rudgames', href: 'https://rudgames.com/' },
  { name: 'ScamLens ID', href: 'https://github.com/patrickivanuellf/scamlens-id' },
]
---

<PageLayout title={t('now.heading')} description={SITE.description[lang]}>
  <div class="mx-auto layout-container px-6 pt-8 pb-16">
    <SectionLabel label={t('now.heading')} class="mb-6" />
    <p class="max-w-[70ch] text-lg leading-relaxed text-text-muted">
      {t('now.introA')}{' '}
      <a href="https://sive.rs" target="_blank" rel="noopener noreferrer" class={INLINE_LINK_CLASS}>
        Derek Sivers
        <Icon name="arrow-up-right" class="h-3 w-3" />
      </a>
      {t('now.introB')}{' '}
      <a
        href="https://nownownow.com"
        target="_blank"
        rel="noopener noreferrer"
        class={INLINE_LINK_CLASS}
      >
        nownownow.com
        <Icon name="arrow-up-right" class="h-3 w-3" />
      </a>.
    </p>
    <p class="mt-6 font-mono text-sm text-text-muted">
      <span class="mr-2 inline-block h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
      {t('now.lastUpdated')}
      {lastUpdated}
    </p>

    <hr class="my-10 border-border" />

    <div class="divide-y divide-border">
      <section class="grid gap-3 py-8 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
        <p class="pt-1 font-mono text-sm text-text-muted">{t('now.rowFocus')}</p>
        <div>
          <h2 class="text-2xl font-medium">{t('now.focusTitle')}</h2>
          <p class="mt-3 max-w-[70ch] leading-relaxed text-text-muted">{t('now.focusBody')}</p>
        </div>
      </section>

      <section class="grid gap-3 py-8 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
        <p class="pt-1 font-mono text-sm text-text-muted">{t('now.rowBuilding')}</p>
        <div>
          <h2 class="text-2xl font-medium">{t('now.buildingTitle')}</h2>
          <p class="mt-3 max-w-[70ch] leading-relaxed text-text-muted">{t('now.buildingBody')}</p>
          <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
            {
              projects.map((project) => (
                <a
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={INLINE_LINK_CLASS}
                >
                  {project.name}
                  <Icon name="arrow-up-right" class="h-3 w-3" />
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="grid gap-3 py-8 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
        <p class="pt-1 font-mono text-sm text-text-muted">{t('now.rowOpen')}</p>
        <div>
          <h2 class="text-2xl font-medium">{t('now.openTitle')}</h2>
          <ul class="mt-4 space-y-2 text-text-muted">
            {openTo.map((key) => <li>{t(key)}</li>)}
          </ul>
        </div>
      </section>
    </div>

    <p class="mt-12 text-sm text-text-muted">{t('now.note')}</p>
  </div>
</PageLayout>
