---
import PageLayout from '@/layouts/PageLayout.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import InfoRow from '@/components/ui/InfoRow.astro'
import ExternalLink from '@/components/ui/ExternalLink.astro'
import NowItemList from '@/components/ui/NowItemList.astro'
import { SITE, PAGE_CONTAINER_CLASS } from '@/lib/constants'
import { getNowItems, getNowLastUpdated } from '@/lib/now-items'
import { useLocale, formatShortDate } from '@/i18n/utils'

const { lang, t } = useLocale(Astro.currentLocale)

const learning = await getNowItems('learning')
const reading = await getNowItems('reading')
const listening = await getNowItems('listening')
const lastUpdated = formatShortDate(await getNowLastUpdated(), lang)

const openTo = [
  'now.itemWork',
  'now.itemContribution',
  'now.itemInternship',
  'now.itemCollaboration',
]

const projects = [
  { name: 'TeaMusic', href: 'https://teamusic.my.id/' },
  { name: 'SDK Ads', href: 'https://github.com/rafifhardjaa/SdkAds' },
  { name: 'Rudgames', href: 'https://rudgames.com/' },
  { name: 'ScamLens ID', href: 'https://github.com/patrickivanuellf/scamlens-id' },
]
---

<PageLayout title={t('now.heading')} description={SITE.description[lang]}>
  <div class={PAGE_CONTAINER_CLASS}>
    <SectionLabel label={t('now.heading')} as="h1" class="mb-6" />
    <p class="max-w-[70ch] text-lg leading-relaxed text-text-muted">
      {t('now.introA')}{' '}
      <ExternalLink href="https://sive.rs">Derek Sivers</ExternalLink>
      {t('now.introB')}{' '}
      <ExternalLink href="https://nownownow.com">nownownow.com</ExternalLink>.
    </p>
    <p class="mt-6 font-mono text-sm text-text-muted">
      <span class="mr-2 inline-block h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
      {t('now.lastUpdated')}
      {lastUpdated}
    </p>

    <hr class="my-12 border-border" />

    <div class="divide-y divide-border">
      <InfoRow label={t('now.rowFocus')} title={t('now.focusTitle')}>
        <p class="mt-3 max-w-[70ch] leading-relaxed text-text-muted">{t('now.focusBody')}</p>
      </InfoRow>

      <InfoRow label={t('now.rowBuilding')} title={t('now.buildingTitle')}>
        <p class="mt-3 max-w-[70ch] leading-relaxed text-text-muted">{t('now.buildingBody')}</p>
        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          {
            projects.map((project) => (
              <ExternalLink href={project.href}>{project.name}</ExternalLink>
            ))
          }
        </div>
      </InfoRow>

      <InfoRow label={t('now.rowLearning')} title={t('now.learningTitle')}>
        <NowItemList items={learning} lang={lang} />
      </InfoRow>

      <InfoRow label={t('now.rowReading')} title={t('now.readingTitle')}>
        <NowItemList items={reading} lang={lang} />
      </InfoRow>

      <InfoRow label={t('now.rowListening')} title={t('now.listeningTitle')}>
        <NowItemList items={listening} lang={lang} />
      </InfoRow>

      <InfoRow label={t('now.rowOpen')} title={t('now.openTitle')}>
        <ul class="mt-4 space-y-2 text-text-muted">
          {openTo.map((key) => <li>{t(key)}</li>)}
        </ul>
      </InfoRow>
    </div>

    <p class="mt-12 text-sm text-text-muted">{t('now.note')}</p>
  </div>
</PageLayout>
