---
import { Icon as AstroIcon } from 'astro-icon/components'

// NOTE (Oct 2026): astro-icon inlines each icon's <symbol> only on its first
// occurrence per Astro.locals object, later usages render a bare <use>.
// During static builds exactly one page — /id/404/ — deterministically
// reuses a locals object, so all 16 of its icons rendered blank (verified:
// 16 <use> refs, 0 symbol definitions, every other page intact).
// Rendering inline removes the shared-state mechanism entirely: every usage
// carries its own paths, so no page can ever lose its icons again.
type IconName =
  | 'github'
  | 'linkedin'
  | 'instagram'
  | 'threads'
  | 'terminal'
  | 'mail'
  | 'arrow-up-right'
  | 'rss'
  | 'sliders'
  | 'languages'
  | 'list'
  | 'chevron-down'
  | 'check'
  | 'monitor'
  | 'power'
  | 'contrast'
  | 'layout-default'
  | 'layout-wide'
  | 'layout-wider'
  | 'nav-home'
  | 'nav-notes'
  | 'nav-now'
  | 'nav-uses'
  | 'nav-contact'

const ICONS: Record<IconName, string> = {
  github: 'lucide:github',
  linkedin: 'lucide:linkedin',
  instagram: 'lucide:instagram',
  // Lucide ships no Threads glyph; the @ mark is Threads' visual identity.
  threads: 'lucide:at-sign',
  terminal: 'lucide:terminal',
  mail: 'lucide:mail',
  'arrow-up-right': 'lucide:arrow-up-right',
  rss: 'lucide:rss',
  sliders: 'lucide:sliders-horizontal',
  list: 'lucide:list',
  'chevron-down': 'lucide:chevron-down',
  languages: 'lucide:languages',
  check: 'lucide:check',
  monitor: 'lucide:monitor',
  power: 'lucide:power',
  contrast: 'lucide:contrast',
  'layout-default': 'lucide:rectangle-horizontal',
  'layout-wide': 'lucide:layout-panel-top',
  'layout-wider': 'lucide:maximize-2',
  'nav-home': 'lucide:house',
  'nav-notes': 'lucide:file-text',
  'nav-now': 'lucide:activity',
  'nav-uses': 'lucide:wrench',
  'nav-contact': 'lucide:mail',
}

interface Props {
  name: IconName
  class?: string
}

const { name, class: className } = Astro.props
---

<AstroIcon name={ICONS[name]} class={className} is:inline />
