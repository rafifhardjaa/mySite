---
import ThemeToggle from './ThemeToggle.astro'
import SettingsMenu from './SettingsMenu.astro'
import Icon from '@/components/ui/Icon.astro'
import { NAV_LINKS } from '@/lib/constants'
import { useTranslation, localePath, type LangKey } from '@/i18n/utils'

interface Props {
  lang: LangKey
  // null hides the language switch: the current page has no counterpart in the
  // other locale (a note that is not translated yet).
  localeSwitchHref?: string | null
}

const { lang, localeSwitchHref } = Astro.props
const t = useTranslation(lang)
const currentPath = Astro.url.pathname

// Astro.url.pathname keeps the trailing slash (/notes/) while localePath()
// strips it (/notes). Without normalising, no link is ever active except /.
const currentRoute = currentPath !== '/' ? currentPath.replace(/\/$/, '') : currentPath

// Exact match, plus section match: a note page lives under /notes, so the
// Notes entry stays lit there. A locale root ("/" or "/id") never
// prefix-matches — every route on that locale starts with one, so without
// this guard Home would light up on every Indonesian page.
const isActiveRoute = (href: string): boolean => {
  if (currentRoute === href) return true
  const depth = href.split('/').filter(Boolean).length
  const rootDepth = lang === 'en' ? 0 : 1
  return depth > rootDepth && currentRoute.startsWith(`${href}/`)
}

const navIcons = {
  '/': 'nav-home',
  '/notes': 'nav-notes',
  '/now': 'nav-now',
  '/uses': 'nav-uses',
  '/contact': 'nav-contact',
} as const

const dockLinks = NAV_LINKS.filter((link) => link.href in navIcons)
---

<nav
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 hidden px-6 pt-4 transition-[transform,opacity] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] md:block"
>
  <div
    class="nav-pill mx-auto flex layout-container items-center justify-between rounded-[2rem] border border-border bg-bg/85 px-5 py-2 shadow-sm shadow-black/5 backdrop-blur-xl"
  >
    <div class="flex items-center gap-5">
      {
        NAV_LINKS.map((link) => {
          const href = localePath(lang, link.href)
          const active = isActiveRoute(href)
          return (
            <a
              href={href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                // Animated underline shared by hover, keyboard focus and the
                // active page. It grows left to right from a rounded 2px bar.
                // Active uses the line instead of font-medium, so navigating
                // no longer shifts the row width by a weight change.
                'relative pb-1 text-sm transition-colors after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-full after:origin-left after:rounded-full after:bg-accent after:transition-transform after:duration-[250ms] after:ease-[cubic-bezier(0.22,1,0.36,1)]',
                active
                  ? 'text-text after:scale-x-100'
                  : 'text-text-muted after:scale-x-0 hover:text-text hover:after:scale-x-100 focus-visible:text-text focus-visible:after:scale-x-100 focus-visible:outline-none',
              ]}
            >
              {t(link.key)}
            </a>
          )
        })
      }
    </div>

    <div class="flex items-center gap-0.5">
      <ThemeToggle />
      <div class="relative">
        <button
          type="button"
          data-settings-toggle
          aria-label="Settings"
          title="Settings"
          aria-expanded="false"
          aria-controls="settings-menu-desktop"
          class="flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-bg-subtle data-[open]:bg-bg-subtle"
        >
          <Icon name="sliders" class="h-[18px] w-[18px] text-text" />
        </button>
        <div
          id="settings-menu-desktop"
          class="absolute right-0 top-full mt-2 hidden origin-top-right"
        >
          <SettingsMenu lang={lang} localeSwitchHref={localeSwitchHref} />
        </div>
      </div>
    </div>
  </div>
</nav>

<div
  data-nav-dock
  class="fixed inset-x-0 bottom-0 z-50 px-4 pb-4 transition-[transform,opacity] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] md:hidden"
>
  <div
    class="mx-auto flex max-w-md items-center justify-between rounded-[2rem] border border-border bg-bg/85 px-3 py-2 shadow-lg shadow-black/5 backdrop-blur-xl"
  >
    <div class="flex items-center gap-0.5">
      {
        dockLinks.map((link) => {
          const href = localePath(lang, link.href)
          const active = isActiveRoute(href)
          return (
            <a
              href={href}
              aria-label={t(link.key)}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex h-10 w-10 items-center justify-center rounded-full transition-colors',
                active
                  ? 'bg-bg-subtle text-accent'
                  : 'text-text-muted hover:bg-bg-subtle hover:text-text',
              ]}
            >
              <Icon name={navIcons[link.href as keyof typeof navIcons]} class="h-[18px] w-[18px]" />
            </a>
          )
        })
      }
    </div>

    <div class="relative flex items-center gap-0.5">
      <ThemeToggle />
      <button
        type="button"
        data-settings-toggle
        aria-label="Settings"
        title="Settings"
        aria-expanded="false"
        aria-controls="settings-menu-mobile"
        class="flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-bg-subtle data-[open]:bg-bg-subtle"
      >
        <Icon name="sliders" class="h-[18px] w-[18px] text-text" />
      </button>
      <div
        id="settings-menu-mobile"
        class="absolute bottom-full right-0 mb-2 hidden origin-bottom-right"
      >
        <SettingsMenu lang={lang} localeSwitchHref={localeSwitchHref} showLayout={false} />
      </div>
    </div>
  </div>
</div>

<style>
  /* Morphing sticky nav: same centered width in both states — only the
     surface morphs (transparent at the top, condensed floating pill once
     scrolled past MORPH_OFFSET, see script below). Keeping the width fixed
     avoids layout shift and keeps the bar aligned with the page content.
     Reduced-motion and the site's animation toggle already neutralise
     transitions globally, so no extra guard is needed here. */
  #site-nav .nav-pill {
    transition:
      background-color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      backdrop-filter 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #site-nav:not([data-scrolled]) .nav-pill {
    background-color: transparent;
    border-color: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
</style>

<script>
  const nav = document.getElementById('site-nav')
  const mobileDock = document.querySelector<HTMLElement>('[data-nav-dock]')

  const TOP_OFFSET = 64
  // Asymmetric hysteresis: 20px to hide (scrolling down), 8px to show (scrolling up).
  // Larger hide threshold prevents flicker from small trackpad bounces; smaller show
  // threshold makes the nav feel responsive when reversing scroll direction.
  const HIDE_DELTA = 20
  const SHOW_DELTA = 8
  // Morph threshold: deliberately deep (120px) so the hero is enjoyed first.
  // Below it the nav is transparent full-width; past it, a condensed pill.
  const MORPH_OFFSET = 120

  let lastY = window.scrollY
  let ticking = false

  function applyVisibility() {
    const y = window.scrollY

    if (y > MORPH_OFFSET) nav?.setAttribute('data-scrolled', '')
    else nav?.removeAttribute('data-scrolled')

    if (y <= TOP_OFFSET) {
      nav?.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none')
      mobileDock?.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none')
    } else if (y > lastY + HIDE_DELTA) {
      // The settings panel lives inside the bar being hidden. Leaving it open
      // would strand aria-expanded="true" and keyboard focus in a hidden menu.
      closeSettings()
      nav?.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none')
      mobileDock?.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none')
    } else if (y < lastY - SHOW_DELTA) {
      nav?.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none')
      mobileDock?.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none')
    }

    lastY = y
    ticking = false
  }

  // Paint the correct state on load too: a reloaded page can restore a
  // scrolled position, and the morph state must match it from the first frame.
  applyVisibility()

  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(applyVisibility)
    },
    { passive: true }
  )

  function closeSettings() {
    document.querySelectorAll('[data-settings-toggle]').forEach((button) => {
      button.setAttribute('aria-expanded', 'false')
      button.removeAttribute('data-open')
    })
    document
      .querySelectorAll('[id^="settings-menu-"]')
      .forEach((menu) => menu.classList.add('hidden'))
  }

  document.addEventListener('click', (event) => {
    const toggle = (event.target as HTMLElement).closest<HTMLElement>('[data-settings-toggle]')

    if (toggle) {
      const panel = document.getElementById(toggle.getAttribute('aria-controls') ?? '')
      const willOpen = toggle.getAttribute('aria-expanded') !== 'true'

      closeSettings()

      if (willOpen && panel) {
        panel.classList.remove('hidden')
        toggle.setAttribute('aria-expanded', 'true')
        toggle.setAttribute('data-open', '')
      }
      return
    }

    if (!(event.target as HTMLElement).closest('[id^="settings-menu-"]')) closeSettings()
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeSettings()
  })
</script>
