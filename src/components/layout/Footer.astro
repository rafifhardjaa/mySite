---
import Icon from '@/components/ui/Icon.astro'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import coverLemonade from '@/assets/covers/lemonade.jpg'
import coverCrazyWorld from '@/assets/covers/crazy-world.jpg'
import coverFreudian from '@/assets/covers/freudian.jpg'
import { SITE } from '@/lib/constants'
import { getNowItems } from '@/lib/now-items'
import { getLang, useTranslation, localePath, type LangKey } from '@/i18n/utils'

type FooterLink = {
  href: string
  label: string
  labelKey?: string
  external?: boolean
  icon?: 'rss'
  noPrefetch?: boolean
}

interface Props {
  lang: LangKey
}

const { lang } = Astro.props
const t = useTranslation(lang)

const handle = SITE.github.replace(/^https?:\/\/github\.com\//, '@')

// Footer teaser for /now: the top "on repeat" track with its cover.
// Covers are vendored in src/assets/covers: the audit flags raw <img>,
// and live artwork search misses real tracks — so each cover is verified
// once by hand and shipped with the site. Keyed by collection entry id
// (glob ids carry no file extension, e.g. "listening-3").
const COVERS: Record<string, ImageMetadata> = {
  'listening-1': coverLemonade,
  'listening-2': coverCrazyWorld,
  'listening-3': coverFreudian,
}
const listening = await getNowItems('listening')
const nowSpinning = listening[0]
const cover = nowSpinning ? COVERS[nowSpinning.id] : undefined
const [track, artist] = (nowSpinning?.data.title[lang] ?? '').split(' — ')
// A verified store URL turns the teaser into an outbound music link;
// otherwise it stays an internal link to /now.
const teaserHref = nowSpinning?.data.storeHref ?? localePath(lang, '/now')
const teaserExternal = Boolean(nowSpinning?.data.storeHref)

const columns: { headingKey: string; links: FooterLink[] }[] = [
  {
    headingKey: 'footer.thisSite',
    links: [
      { href: '/notes', labelKey: 'nav.notes' },
      { href: '/now', labelKey: 'nav.now' },
      { href: '/uses', labelKey: 'nav.uses' },
      { href: '/contact', labelKey: 'contact.navLabel' },
    ],
  },
  {
    headingKey: 'footer.resources',
    links: [
      { href: '/projects', labelKey: 'nav.projects' },
      { href: '/resume', labelKey: 'resume.heading' },
      { href: '/notes/rss.xml', labelKey: 'footer.rss', icon: 'rss', noPrefetch: true },
      { href: '/privacy', labelKey: 'privacy.navLabel' },
      { href: SITE.repo, labelKey: 'footer.source', external: true },
    ],
  },
  {
    headingKey: 'footer.connect',
    links: [
      { href: SITE.github, label: 'GitHub', external: true },
      { href: SITE.linkedin, label: 'LinkedIn', external: true },
      { href: `mailto:${SITE.email}`, label: 'Email' },
    ],
  },
]
---

<footer class="mt-20 border-t border-border py-12">
  <div class="mx-auto layout-container px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between">
      <div>
        <p class="font-mono-jb text-sm text-text">{handle}</p>
        <p class="mt-1 font-mono-jb text-xs text-text-muted">
          © {new Date().getFullYear()}
          {' '}
          {SITE.name}
        </p>
      </div>

      <a
        href={teaserHref}
        {...teaserExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
        class="group flex flex-col text-left sm:items-end sm:text-right"
      >
        <span class="text-xs text-text-muted">{t('footer.latestPlayed')}</span>
        {
          nowSpinning ? (
            <span class="mt-2 flex items-center gap-3">
              {cover && (
                <Image
                  src={cover}
                  alt=""
                  width={40}
                  height={40}
                  loading="lazy"
                  decoding="async"
                  class="h-10 w-10 shrink-0 rounded-md border border-border object-cover"
                />
              )}
              <span class="ml-3 flex flex-col sm:items-end">
                <span class="inline-flex items-center gap-1 text-sm text-text transition-colors group-hover:text-accent">
                  {track}
                  {teaserExternal && <Icon name="arrow-up-right" class="h-3 w-3" />}
                </span>
                {artist && <span class="text-xs text-text-muted">{artist}</span>}
              </span>
            </span>
          ) : (
            <span class="text-sm text-text transition-colors group-hover:text-accent">
              {SITE.role[lang]}
            </span>
          )
        }
      </a>
    </div>

    <div class="mt-10 grid gap-8 sm:grid-cols-3">
      {
        columns.map((column) => (
          <div>
            <h2 class="font-mono-jb text-xs font-medium uppercase tracking-wider text-text-muted">
              {t(column.headingKey)}
            </h2>
            <ul class="mt-4 space-y-3">
              {column.links.map((link) => {
                const href = link.external ? link.href : localePath(lang, link.href)
                return (
                  <li>
                    <a
                      href={href}
                      {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      {...(link.noPrefetch ? { 'data-astro-prefetch': 'false' } : {})}
                      class="inline-flex items-center gap-1 text-sm text-text transition-colors hover:text-accent"
                    >
                      {link.labelKey ? t(link.labelKey) : link.label}
                      {link.icon === 'rss' && <Icon name="rss" class="h-3 w-3 text-text-muted" />}
                      {link.external && <Icon name="arrow-up-right" class="h-3 w-3" />}
                    </a>
                  </li>
                )
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</footer>
