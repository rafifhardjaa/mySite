{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio website",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-agent-endpoints.mjs",
    "preview": "astro preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src worker scripts astro.config.mjs eslint.config.mjs",
    "check": "astro check",
    "assets:og": "python3 scripts/generate-og-assets.py",
    "translate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/translate.mjs",
    "translate-notes": "node --env-file=.env.local scripts/translate-notes.mjs",
    "check:notes": "node scripts/check-notes.mjs",
    "measure:overflow": "node scripts/measure-overflow.mjs",
    "probe": "node scripts/probe.mjs",
    "agent:endpoints": "node scripts/generate-agent-endpoints.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.142",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "astro-icon": "^1.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/node": "^22.5.5",
    "eslint": "^9.11.1",
    "eslint-plugin-astro": "^1.2.3",
    "globals": "^17.13.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.71.2"
  }
}
